# Copy to .env (Copy-Item .env.example .env) and edit. Never commit .env.
# launch.py creates .env from this file automatically if it is missing.

# Wallet secret key. Only needed when DRY_RUN=false, and only read by bot/chain.py.
# Easiest: run `python -m bot.chain new-wallet`, which fills this in for you.
# Otherwise: a base58 string (Phantom/Solflare export) or a JSON byte array (solana-keygen file).
# Use a dedicated wallet holding only the bot's money. Never a recovery phrase.
PRIVATE_KEY=

# Solana mainnet JSON-RPC endpoint.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# true = compute signals and write simulated trades, send nothing on-chain.
DRY_RUN=true

# Hard limits.
MAX_TRADE_USDC=5
MAX_SLIPPAGE_BPS=100
MIN_EQUITY_USD=15

# --- Coins ---
# SOL is always traded. ASSETS adds top coins, each with its own signal and position:
# BTC (wBTC), ETH (wETH), BNB (wBNB), XRP (wXRP), DOGE, AVAX. The first buy of each coin creates its token
# account (~0.002 SOL of refundable rent).
ASSETS=SOL,BTC,ETH,BNB,XRP,DOGE
# Memecoins that trade only while the yellow RISKY switch on the dashboard is on: BONK, WIF, TRUMP, PENGU.
# RISKY mode also runs a simulated sniper for brand-new tokens (dry run only; it never touches the wallet).
RISKY_ASSETS=BONK,WIF,TRUMP,PENGU
# Starting state of the RISKY switch (the dashboard overrides it once you click).
# RISKY=false
# Most positions open at once across all coins.
# MAX_POSITIONS=3

# --- Strategy ---
# sma = moving-average trend rules, ml = the AI (a model trained on candle history), dca = fixed buys.
# Backtests (see README "Results"): every setting below 4h lost money after fees. On 4h candles the settings below
# beat buy & hold with a quarter of its drawdown, and the AI was positive out of sample. Past results only: run the
# dry run first. Train the AI before using it: python -m bot.ml train --timeframe 4h
STRATEGY=sma
TIMEFRAME=4h
# AI: buy when its probability that buying now and selling ML_HORIZON candles later keeps more than ML_TARGET_PCT
# percent AFTER fees and slippage (0.8% round trip) is at least ML_ENTER; sell when it falls to ML_EXIT or below.
# It retrains itself every ML_RETRAIN_HOURS. With ML_ADAPT=true it may raise or lower ML_ENTER, but only once its
# own graded calls prove a better threshold (positive average return, two standard errors clear of zero).
# ML_HORIZON=6
# ML_TARGET_PCT=0.4
# ML_ENTER=0.6
# ML_EXIT=0.45
# ML_RETRAIN_HOURS=24
# ML_TRAIN_DAYS=400
# Moving-average rules (also used for the stops and the BTC filter when STRATEGY=ml).
SMA_FAST=20
SMA_SLOW=50
# cross = only act on the crossover candle. trend = be long whenever fast > slow (lost in every backtest).
ENTRY=cross
# Enter only once fast is this many basis points above slow (cross mode: buy when fast crosses that line). On 4h, 0
# beat 10 and 25 in both halves of the backtest.
EDGE_BPS=0
# Enter only while the close is above a rising slow average (checked on the crossover candle in cross mode).
TREND_CONFIRM=true
# Exit if price falls this many ATRs under the highest close since entry, or this % under the entry price.
STOP_ATR=3
HARD_STOP_PCT=10
# Wait this many candles after a sell before buying that coin again.
REENTRY_CANDLES=0
# Open new positions only while BTC is above its moving average of this many candles (0 = off). Exits never wait.
# In a falling market this keeps the bot flat for days or weeks; the dashboard says so while it does.
REGIME_LEN=400
# Size each buy so that hitting its stop loses about this % of equity (capped at MAX_TRADE_USDC; 0 = always buy the
# full MAX_TRADE_USDC). Volatile coins get smaller positions, so one memecoin swing risks no more than a BTC one.
RISK_PCT=1

# --- Optional (defaults shown) ---
# Native SOL the bot never trades and refuses to dip below (it pays fees and rent).
# GAS_RESERVE_SOL=0.01
# DCA_AMOUNT_USDC=1
# DCA_INTERVAL_HOURS=24
# LOOP_INTERVAL_SECONDS=60
# Dry-run starting balances (simulated).
# SIM_START_USDC=20
# SIM_START_SOL=0.05
# Refuse a swap if the Jupiter quote is this far from the exchange price.
# MAX_QUOTE_DEVIATION_BPS=300
# Refuse a swap whose simulated SOL cost (fees + any account rent) exceeds this many USD.
# MAX_FEE_USD=0.5
# Jupiter swap API (keyless tier).
# JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
# ccxt exchange id used for candles; others are tried as fallbacks.
# CANDLE_EXCHANGE=binance

# --- Sniper (simulated, RISKY mode only) ---
# SNIPER=true
# SNIPER_BANKROLL_USDC=10
# SNIPER_TRADE_USDC=2
# SNIPER_MAX_OPEN=3
# SNIPER_MIN_LIQUIDITY_USD=3000
# SNIPER_MIN_HOLDERS=5
# SNIPER_MAX_AGE_MIN=15
# SNIPER_TAKE_PROFIT=0.5
# SNIPER_STOP_LOSS=0.2
# SNIPER_MAX_HOLD_MIN=30
# SNIPER_LATENCY_SLIPPAGE=0.02

# Where the SQLite database lives (relative to the project folder).
# DB_PATH=data/pocketchange.db
